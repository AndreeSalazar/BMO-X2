body { width:1280px; height:800px; margin:0; background:#0b1019; color:#e8edf6; font-family:LatoLatin; font-size:16px; display:flex; }
div, p, h1, h2, h3 { display:block; margin:0; }
#rail { width:220px; height:800px; background:#101723; border-right:1px #253043; box-sizing:border-box; padding:34px 22px; }
#brand { display:flex; align-items:center; font-weight:bold; font-size:20px; margin-bottom:58px; }
.brand-mark { width:40px; height:40px; line-height:40px; text-align:center; color:#0b1019; background:#7de3d2; border-radius:12px; margin-right:12px; font-size:18px; }
.rail-label { color:#78869d; font-size:10px; letter-spacing:2px; margin:0 12px 18px; }
.nav { height:48px; line-height:48px; border-radius:9px; padding-left:14px; color:#718099; font-size:12px; margin-bottom:8px; }
.nav span { margin-left:16px; font-size:15px; color:#a9b4c6; }
.selected { background:#1a2f39; color:#7de3d2; }
.selected span { color:#d7fff6; }
#rail-bottom { position:absolute; left:34px; bottom:37px; }
.signal { color:#7de3d2; font-size:10px; font-weight:bold; letter-spacing:2px; margin-bottom:10px; }
#rail-bottom p { color:#78869d; line-height:23px; font-size:12px; }
#main { width:1060px; height:800px; padding:32px 46px; box-sizing:border-box; }
#top { display:flex; align-items:center; justify-content:space-between; height:30px; font-size:10px; letter-spacing:2px; }
.muted { color:#8190a8; }
#host-badge { color:#c1b5f6; background:#26223c; border:1px #3c3458; border-radius:12px; padding:7px 12px; font-size:10px; letter-spacing:1px; }
#intro { margin-top:51px; margin-bottom:36px; }
.eyebrow { font-size:10px; color:#7de3d2; letter-spacing:2px; font-weight:bold; margin-bottom:15px; }
h1 { font-size:42px; font-weight:bold; letter-spacing:-1px; margin-bottom:13px; }
#intro p { color:#8f9eb5; font-size:16px; }
#workspace { display:flex; height:393px; }
#focus-panel { width:586px; background:#131e2a; border:1px #2b3b4c; border-radius:18px; padding:27px 30px; box-sizing:border-box; }
.panel-top { display:flex; justify-content:space-between; font-size:10px; letter-spacing:2px; }
.cyan { color:#7de3d2; }
.symbol { color:#7de3d2; font-weight:bold; font-size:28px; margin-top:35px; margin-bottom:23px; letter-spacing:5px; }
h2 { font-size:24px; font-weight:bold; margin-bottom:12px; }
.description { color:#94a4bb; line-height:25px; font-size:14px; }
button { display:block; background:#7de3d2; color:#10232b; border-width:0; border-radius:9px; padding:14px 23px; margin-top:24px; font-family:LatoLatin; font-weight:bold; font-size:14px; }
button:hover { background:#a2f4e6; }
#result { color:#8598af; font-size:12px; margin-top:16px; }
#side-panel { width:356px; margin-left:24px; padding:27px 28px; box-sizing:border-box; background:#131a28; border:1px #2a3044; border-radius:18px; }
#side-panel h2 { font-size:22px; margin-bottom:26px; }
.layer { display:flex; align-items:center; margin-bottom:24px; }
.layer-index { width:34px; height:34px; line-height:34px; text-align:center; color:#7de3d2; background:#193139; border-radius:9px; margin-right:15px; font-size:11px; }
.violet { color:#c1b5f6; background:#29243f; }
.green { color:#c1dc89; background:#263225; }
h3 { font-size:14px; font-weight:bold; margin-bottom:5px; }
.layer p { font-size:12px; color:#8493ab; }
#state { font-size:12px; color:#a1aec2; border-top:1px #2a3044; padding-top:18px; }
#state.ready { color:#7de3d2; }
#bottom { display:flex; justify-content:space-between; align-items:center; margin-top:35px; padding-top:23px; border-top:1px #253043; font-size:9px; letter-spacing:1px; }
.footer-note { color:#64748c; font-size:9px; }
