* text=auto eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.casm text eol=lf
*.hex text eol=lf
*.patch text eol=lf
# The imported CASM snapshot has byte hashes; preserve those original bytes.
CASM/** -text whitespace=cr-at-eol
kernel/boot/bridge/*.hex -text whitespace=cr-at-eol
kernel/boot/bridge/LEEME.md -text whitespace=cr-at-eol
kernel/boot/genesis/evidence/registers.txt -text -diff
# A stored patch contains significant context prefixes; keep its exact bytes.
CASM/traspaso/*.patch whitespace=-blank-at-eol,cr-at-eol
kernel/boot/stop/evidence/registers.txt -text -diff
Reports/nvidia-pci-metal-*.bootlog.txt -text whitespace=cr-at-eol
