set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
file(TO_CMAKE_PATH "$ENV{ProgramFiles}/LLVM/bin" BMO_LLVM_BIN)
set(CMAKE_C_COMPILER "${BMO_LLVM_BIN}/clang.exe")
set(CMAKE_CXX_COMPILER "${BMO_LLVM_BIN}/clang++.exe")
set(CMAKE_ASM_COMPILER "${BMO_LLVM_BIN}/clang.exe")
set(CMAKE_C_COMPILER_TARGET x86_64-unknown-none-elf)
set(CMAKE_CXX_COMPILER_TARGET x86_64-unknown-none-elf)
set(CMAKE_ASM_COMPILER_TARGET x86_64-unknown-none-elf)
set(CMAKE_AR "${BMO_LLVM_BIN}/llvm-ar.exe")
set(CMAKE_RANLIB "${BMO_LLVM_BIN}/llvm-ranlib.exe")
set(CMAKE_LINKER "${BMO_LLVM_BIN}/ld.lld.exe")
set(CMAKE_C_FLAGS_INIT "-ffreestanding -fno-stack-protector -fno-pic -fno-pie -mno-red-zone -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -nostdinc++ -fno-threadsafe-statics -fno-use-cxa-atexit")
