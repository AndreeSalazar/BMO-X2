#ifndef BMO_NATIVE_UI_LAYOUT_INC
#define BMO_NATIVE_UI_LAYOUT_INC

#define NATIVE_UI_PHYSICAL 0x04000000
#define NATIVE_UI_VIRTUAL_DATA 0x40400000
#ifdef BMO_FULL_HD
#define NATIVE_UI_DATA_BYTES 0xc00000
#else
#define NATIVE_UI_DATA_BYTES 0xa00000
#endif
#define NATIVE_UI_STACK_BYTES 0x200000
#define NATIVE_UI_DATA_END (NATIVE_UI_VIRTUAL_DATA + NATIVE_UI_DATA_BYTES)
#define NATIVE_UI_POOL_BYTES (0x400000 + NATIVE_UI_DATA_BYTES + NATIVE_UI_STACK_BYTES)
#define NATIVE_UI_POOL_END (NATIVE_UI_PHYSICAL + NATIVE_UI_POOL_BYTES)
#define NATIVE_UI_POOL_PAGES (NATIVE_UI_POOL_BYTES / 4096)

#endif
