#ifndef BMO_NVIDIA_GSP_LAYOUT
#define BMO_NVIDIA_GSP_LAYOUT

#define GSP_STAGE_BASE 0x800
#define GSP_STAGE_LENGTH 0x808
#define GSP_STAGE_STATUS 0x810
#define GSP_POST_STATUS 0x814
#define GSP_POST_IMAGE 0x818
#define GSP_POST_SIGNATURE 0x820
#define GSP_POST_RADIX3 0x828
#define GSP_POST_DMA_ROOT 0x830
#define GSP_POST_RMARGS 0x838
#define GSP_POST_LIBOS 0x840
#define GSP_POST_BOOT_CHAIN 0x848
#ifdef BMO_NVIDIA_GSP_LIBOS
#define GSP_POST_READY 5
#elif defined(BMO_NVIDIA_GSP_QUEUES)
#define GSP_POST_READY 4
#else
#define GSP_POST_READY 3
#endif
#ifdef BMO_AMDVI_GSP_DMA
// This QEMU profile owns the separate NVMe code page at 0x1f000.
// The GSP stage runs once before AMD-Vi and USB reuse the scratch PT.
#define GSP_POST_CODE 0x1e000
#else
#define GSP_POST_CODE 0x1f000
#endif
#define GSP_FILE_PAGES ((BMO_GSP_FILE_BYTES+4096)/4096)
#if defined(BMO_NVIDIA_GSP_PREPARE) && defined(BMO_GSP_IMAGE_BYTES)
#define GSP_IMAGE_PAGES (BMO_GSP_IMAGE_BYTES/4096)
#define GSP_RADIX_PAGES (2+(GSP_IMAGE_PAGES+511)/512)
#define GSP_DMA_READ_PAGES (GSP_IMAGE_PAGES+1+GSP_RADIX_PAGES)
#define GSP_DMA_TABLE_PAGES (1+(GSP_DMA_READ_PAGES+511)/512)
#define GSP_DMA_FIRST_IOVA 0x08000000
#define GSP_RADIX_OFFSET ((GSP_IMAGE_PAGES+1)*4096)
#define GSP_DMA_TABLE_OFFSET (GSP_DMA_READ_PAGES*4096)
#define GSP_DMA_END_PAGES (GSP_DMA_READ_PAGES+GSP_DMA_TABLE_PAGES)
#ifdef BMO_NVIDIA_GSP_QUEUES
#define GSP_QUEUE_PAGE_COUNT 64
#define GSP_QUEUE_BYTES (GSP_QUEUE_PAGE_COUNT*4096)
#define GSP_SHARED_QUEUE_PAGES (1+2*GSP_QUEUE_PAGE_COUNT)
#define GSP_QUEUE_AREA_PAGES (1+GSP_SHARED_QUEUE_PAGES)
#define GSP_QUEUE_AREA_OFFSET (GSP_DMA_END_PAGES*4096)
#define GSP_QUEUE_IOVA 0x0a000000
#ifdef BMO_NVIDIA_GSP_LIBOS
#define GSP_LIBOS_LOG_PAGES (6*16+2)
#define GSP_LIBOS_PAGE_INDEX GSP_QUEUE_AREA_PAGES
#define GSP_LIBOS_AREA_OFFSET (GSP_QUEUE_AREA_OFFSET+GSP_LIBOS_PAGE_INDEX*4096)
#define GSP_LIBOS_IOVA (GSP_QUEUE_IOVA+GSP_LIBOS_PAGE_INDEX*4096)
#define GSP_SHARED_AREA_PAGES (GSP_QUEUE_AREA_PAGES+1+GSP_LIBOS_LOG_PAGES)
#else
#define GSP_SHARED_AREA_PAGES GSP_QUEUE_AREA_PAGES
#endif
#define GSP_QUEUE_LEAF_OFFSET (GSP_QUEUE_AREA_OFFSET+GSP_SHARED_AREA_PAGES*4096)
#ifdef BMO_NVIDIA_GSP_BOOT_CHAIN
#define GSP_BOOT_AREA_OFFSET (GSP_QUEUE_LEAF_OFFSET+4096)
#define GSP_BOOT_IOVA (GSP_QUEUE_IOVA+GSP_SHARED_AREA_PAGES*4096)
#define GSP_STAGE_PAGES (GSP_DMA_END_PAGES+GSP_SHARED_AREA_PAGES+1+BMO_GSP_BOOT_PAGES)
#define GSP_SHARED_LEAF_PAGES (GSP_SHARED_AREA_PAGES+BMO_GSP_BOOT_PAGES)
#if BMO_GSP_BOOT_FILE_OFFSET+BMO_GSP_BOOT_PAGES*4096 > GSP_BOOT_AREA_OFFSET
#error The signed boot chain source must be below the detached DMA area
#endif
#else
#define GSP_STAGE_PAGES (GSP_DMA_END_PAGES+GSP_SHARED_AREA_PAGES+1)
#define GSP_SHARED_LEAF_PAGES GSP_SHARED_AREA_PAGES
#endif
#if GSP_DMA_FIRST_IOVA+GSP_DMA_READ_PAGES*4096 > GSP_QUEUE_IOVA || GSP_STAGE_PAGES < GSP_FILE_PAGES || GSP_SHARED_LEAF_PAGES > 512
#error GSP queue reservation does not fit its detached DMA layout
#endif
#elif GSP_DMA_END_PAGES > GSP_FILE_PAGES
#define GSP_STAGE_PAGES GSP_DMA_END_PAGES
#endif
#endif
#ifndef GSP_STAGE_PAGES
#define GSP_STAGE_PAGES GSP_FILE_PAGES
#endif

#endif
