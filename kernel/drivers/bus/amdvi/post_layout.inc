#ifndef BMO_AMDVI_POST_LAYOUT
#define BMO_AMDVI_POST_LAYOUT

// Native desktop context. The snapshot follows the pre-EBS report buffer.
#ifdef BMO_AMDVI_STORAGE
#ifdef BMO_AMDVI_GSP_DMA
#define AMDVI_POST_CODE 0x1b3a0
#else
#define AMDVI_POST_CODE 0x1b600
#endif
#ifdef BMO_AMDVI_NVME
#define AMDVI_LAB_DATA_PAGES 31
#else
#define AMDVI_LAB_DATA_PAGES 18
#endif
#ifdef BMO_AMDVI_ROUTED
#define AMDVI_LAB_TABLE_PAGES 512
#define AMDVI_LAB_PAGES (AMDVI_LAB_DATA_PAGES+AMDVI_LAB_TABLE_PAGES)
#else
#define AMDVI_LAB_PAGES AMDVI_LAB_DATA_PAGES
#endif
#else
#ifdef BMO_AMDVI_PHYSICAL_PREPARE
#define AMDVI_POST_CODE 0x1b5f0
#elif defined(BMO_STORAGE_QUIESCE)
#define AMDVI_POST_CODE 0x1b600
#else
#define AMDVI_POST_CODE 0x1b800
#endif
#define AMDVI_LAB_PAGES 14
#endif
#define AMDVI_POST_BASE 0xb00
#define AMDVI_POST_PCI 0xb08
#define AMDVI_POST_PCI_LOW 0xb0c
#define AMDVI_POST_STATUS 0xb10
#define AMDVI_POST_REGISTERS 0xb18
#define AMDVI_POST_PTE0 0xb40
#define AMDVI_POST_PTE2 0xb48
#define AMDVI_POST_DIAGNOSTIC 25
#define AMDVI_DTE_POST_STATUS 0x758
#define AMDVI_DTE_POST_ZERO_QWORDS 0x760
#define AMDVI_DTE_POST_PTE_FIRST 0x768
#define AMDVI_DTE_POST_PTE_LAST 0x770
#define AMDVI_LAB_SCRATCH 0xb50
#define AMDVI_LAB_REQUEST 0xb58
#define AMDVI_LAB_RESULT 0xb60
#define AMDVI_LAB_PHASE 0xb68
#define AMDVI_LAB_CONTROL_AFTER_STOP 0xb70
#define AMDVI_LAB_EDU_RID 0xb78
#define AMDVI_LAB_PRESENT_COUNT 0xb80
#ifdef BMO_AMDVI_DTE_RESERVE
// UEFI-owned memory reservation only; this does not program AMD-Vi.
#define AMDVI_DTE_RESERVE_BASE 0x738
#define AMDVI_DTE_RESERVE_PAGES 0x740
#define AMDVI_DTE_RESERVE_STATUS 0x748
#define AMDVI_DTE_RESERVE_ZERO_QWORDS 0x750
#define AMDVI_DTE_TABLE_PAGES 512
#define AMDVI_DTE_TABLE_QWORDS (AMDVI_DTE_TABLE_PAGES*4096/8)
#define AMDVI_DTE_TABLE_BYTES (AMDVI_DTE_TABLE_PAGES*4096)
#endif
#if defined(BMO_AMDVI_ROUTED) && defined(BMO_AMDVI_NVME)
// Keep the inventory away from the NVMe and AHCI counters at 0xbc0.
#define AMDVI_LAB_PRESENT_RIDS 0x850
#else
#define AMDVI_LAB_PRESENT_RIDS 0xb88
#endif
#define AMDVI_LAB_MAX_PRESENT 64
#ifdef BMO_AMDVI_GUEST_NVME
#define AMDVI_GUEST_NVME_CODE 0x1f000
#define AMDVI_GUEST_NVME_READS 0xbc0
#define AMDVI_GUEST_NVME_ACK 0xbc8
#define AMDVI_GUEST_NVME_STEP 0xbd0
#endif
#ifdef BMO_AMDVI_GUEST_AHCI
#define AMDVI_GUEST_AHCI_READS 0xbd8
#define AMDVI_GUEST_AHCI_STEP 0xbe0
#define AMDVI_GUEST_NVME_HANDOFF 0xbe8
#define AMDVI_GUEST_AHCI_HANDOFF 0xbf0
#endif
#define AMDVI_LAB_CODE (AMDVI_POST_CODE+5)
#define DMA_CENSUS_CODE (AMDVI_POST_CODE+5)
#define DMA_CENSUS_HEADER 0xb80
#define DMA_CENSUS_READY 0xb88
#define DMA_CENSUS_ROWS 0xb90
#define DMA_CENSUS_MAX 64
#define DMA_CENSUS_SELECTOR 26
#ifdef BMO_AMDVI_PHYSICAL_MMIO_TEST
#define AMDVI_PHYSICAL_MMIO_CODE 0x12000
#endif
#ifdef BMO_AMDVI_PHYSICAL_USB_TEST
#define AMDVI_PHYSICAL_USB_ENTRY 0x12005
#define AMDVI_PHYSICAL_RTX_REPORT 0x1200f
#define AMDVI_PHYSICAL_USB_RECEIPT 0x920
#define AMDVI_PHYSICAL_USB_STATE (AMDVI_PHYSICAL_USB_RECEIPT+80)
#define AMDVI_PHYSICAL_USB_RESULT (AMDVI_PHYSICAL_USB_RECEIPT+88)
#define NVIDIA_FALCON_RESET_RESULT 0x980
#define NVIDIA_FWSEC_LAUNCH_STATUS 0x990
#define NVIDIA_FWSEC_LAUNCH_RECEIPT 0x998
#define NVIDIA_PHYSICAL_CODE_BASE 0x9c0
#define NVIDIA_PHYSICAL_FWSEC_ENTRY 5
#define AMDVI_BOARD_IVRS_MATCH 0x9c8
#define AMDVI_PHYSICAL_LPC_STATUS 0x9d0
#define AMDVI_PHYSICAL_LPC_COMMAND 0x9d8
#endif
#ifdef BMO_STORAGE_STATE
#include "../../storage/handoff_layout.inc"
#endif

#endif
